# Copy to .env (repo root). Everything works with zero configuration in demo mode.

# --- AI provider: demo | gemini | ollama | groq ----------------------------
AI_PROVIDER=demo
EMBEDDING_PROVIDER=hash          # hash | gemini | ollama

# Google AI Studio (Gemini API), free tier. Key: https://aistudio.google.com/apikey
# Free-tier requests may be used by Google to improve its products; don't send confidential notes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash             # pin a stable model; *-latest aliases can be overloaded
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest   # used automatically on HTTP 503 (high demand)
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_RPM=10                    # requests per minute (raise on a paid key)

# Ollama (free, local). From Docker the backend reaches the host at host.docker.internal.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=all-minilm    # 384-dim; run: ollama pull all-minilm

# Groq (free tier, needs an account key)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Research rules ---------------------------------------------------------
MIN_INTERVIEWS_FOR_SYNTHESIS=5

# Research copilot (interactive): fail over sooner than background synthesis.
# COPILOT_TIMEOUT_SECONDS=30
# COPILOT_MAX_RETRIES=2
